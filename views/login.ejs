<%- include('partials/head', { appName, pageTitle: 'Login Admin - ' + appName }) %>
  <header class="site-header">
    <nav class="container site-nav" aria-label="Navigasi utama">
      <a href="/" class="brand-wordmark"><%= appName %></a>
      <div class="nav-links-inline">
        <a href="/" class="nav-link">Beranda</a>
        <a href="/admin/login" aria-current="page" class="nav-link">Login Admin</a>
      </div>
    </nav>
  </header>

  <main id="konten-utama" class="login-stage">
    <div class="container">
      <div class="login-shell">
        <h1 class="section-title">Login Admin</h1>
        <p class="section-subtitle">Masuk untuk mengelola katalog hidangan dan memantau pesanan yang masuk.</p>

        <% if (loginError) { %>
          <p role="alert" class="alert-error"><%= loginError %></p>
        <% } %>

        <form action="/admin/login" method="post" class="login-card">
          <div>
            <label for="username" class="field-label">Username</label>
            <input id="username" name="username" autocomplete="username" required maxlength="100"
              placeholder="Masukkan username admin"
              class="field-input <%= loginError ? 'is-error t-input is-shaking' : '' %>">
          </div>
          <div>
            <label for="password" class="field-label">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required
              placeholder="Masukkan password admin"
              class="field-input <%= loginError ? 'is-error t-input is-shaking' : '' %>">
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">Masuk ke Dapur Admin</button>
        </form>
      </div>
    </div>
  </main>
<%- include('partials/footer', { appName }) %>
