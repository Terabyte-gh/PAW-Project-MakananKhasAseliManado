<%- include('partials/head', { appName }) %>
  <header class="border-b border-stone-200 bg-white">
    <nav class="flex h-16 items-center justify-between px-6 lg:px-10">
      <a href="/" class="font-semibold"><%= appName %></a>
      <div class="flex items-center gap-6 text-sm text-stone-600">
        <a href="/" class="hover:text-stone-900">Dashboard</a>
        <a href="/admin/login" aria-current="page" class="font-semibold text-stone-900">Login Admin</a>
      </div>
    </nav>
  </header>
  <main class="bg-stone-100 px-6 py-16">
   <div class="mx-auto max-w-md">
    <h1 class="text-2xl font-semibold">Login Admin</h1>
    <p class="mt-2 text-sm text-stone-600">Masuk untuk mengelola data makanan.</p>
    <% if (loginError) { %><p role="alert" class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-700"><%= loginError %></p><% } %>
    <form action="/admin/login" method="post" class="mt-6 space-y-4 rounded-lg border border-stone-200 bg-white p-5">
      <div>
        <label for="username" class="text-sm text-stone-600">Username</label>
        <input id="username" name="username" autocomplete="username" required maxlength="100" class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm">
      </div>
      <div>
        <label for="password" class="text-sm text-stone-600">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm">
      </div>
      <button class="w-full rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white">Masuk</button>
    </form>
   </div>
  </main>
<%- include('partials/footer', { appName }) %>
