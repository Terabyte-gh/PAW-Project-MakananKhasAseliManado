<%- include('partials/head', { appName }) %>

<%
const galeri = [
  { src: '/images/tinutuan.jpg', alt: 'Semangkuk tinutuan hangat khas Manado', caption: 'Tinutuan sayur segar', width: 736, height: 1308 },
  { src: '/images/cakalang-dabu-dabu.jpg', alt: 'Ikan cakalang goreng dengan sambal dabu-dabu', caption: 'Cakalang dabu-dabu', width: 819, height: 1024 },
  { src: '/images/cakalang-fufu.png', alt: 'Cakalang fufu asap khas Sulawesi Utara', caption: 'Cakalang fufu asap', width: 400, height: 296 },
  { src: '/images/dabu-dabu.jpg', alt: 'Sambal dabu-dabu segar dalam mangkuk batu', caption: 'Sambal dabu-dabu segar', width: 1081, height: 1600 },
  { src: '/images/nasi-kuning.jpg', alt: 'Nasi kuning dengan lauk khas Manado', caption: 'Nasi kuning khas Manado', width: 747, height: 1328 },
];

function cariFotoProduk(nama) {
  const n = String(nama || '').toLocaleLowerCase('id-ID');
  if (n.includes('tinutuan') || n.includes('bubur')) return galeri[0];
  if (n.includes('fufu')) return galeri[2];
  if (n.includes('cakalang')) return galeri[1];
  if (n.includes('dabu') || n.includes('sambal') || n.includes('rica')) return galeri[3];
  if (n.includes('nasi kuning') || n.includes('nasi')) return galeri[4];
  return null;
}

const featuredDish = produk.length > 0 ? produk[0] : null;
const featuredPhoto = featuredDish ? (cariFotoProduk(featuredDish.makanan) || galeri[0]) : galeri[0];
const heroPhoto = featuredPhoto.src === galeri[1].src ? galeri[0] : galeri[1];
const sisaProduk = produk.length > 1 ? produk.slice(1) : [];

const endpoints = [
  { method: 'GET', path: '/api/status', href: '/api/status', desc: 'Status kesehatan server' },
  { method: 'GET', path: '/api/produk', href: '/api/produk', desc: 'Daftar seluruh hidangan' },
  { method: 'GET', path: '/api/produk/:id', href: '/api/produk/1', desc: 'Detail hidangan (contoh ID 1)' },
  { method: 'GET', path: '/api/pesanan/status/:kode', href: null, desc: 'Lacak status kode pesanan' },
  { method: 'POST', path: '/api/produk', href: null, desc: 'Tambah menu baru (admin)' },
  { method: 'PUT', path: '/api/produk/:id', href: null, desc: 'Perbarui data menu (admin)' },
  { method: 'DELETE', path: '/api/produk/:id', href: null, desc: 'Hapus menu (admin)' },
];
%>

  <header class="site-header">
    <nav class="container site-nav" aria-label="Navigasi utama">
      <a href="/" class="brand-wordmark"><%= appName %></a>

      <div class="nav-links-desktop">
        <a href="#produk" class="nav-link">Menu</a>
        <a href="#galeri" class="nav-link">Galeri</a>
        <a href="#cek-pesanan" class="nav-link">Cek Pesanan</a>
        <a href="#api" class="nav-link">API</a>
        <% if (isAdmin) { %>
          <a href="#daftar-pesanan" class="nav-link">Pesanan Masuk</a>
          <form action="/admin/logout" method="post" style="margin:0;">
            <button type="submit" class="nav-auth-btn">Logout Admin</button>
          </form>
        <% } else { %>
          <a href="/admin/login" class="nav-auth-btn">Login Admin</a>
        <% } %>
      </div>

      <button type="button" id="mobile-nav-toggle" class="nav-mobile-toggle"
        aria-expanded="false" aria-controls="mobile-nav-drawer" aria-label="Buka menu navigasi">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </nav>

    <div id="mobile-nav-drawer" class="nav-mobile-drawer" hidden>
      <a href="#produk" class="nav-link">Menu</a>
      <a href="#galeri" class="nav-link">Galeri</a>
      <a href="#cek-pesanan" class="nav-link">Cek Pesanan</a>
      <a href="#api" class="nav-link">API</a>
      <% if (isAdmin) { %>
        <a href="#daftar-pesanan" class="nav-link">Pesanan Masuk</a>
        <form action="/admin/logout" method="post" style="margin-top:0.35rem;">
          <button type="submit" class="nav-auth-btn">Logout Admin</button>
        </form>
      <% } else { %>
        <a href="/admin/login" class="nav-auth-btn" style="margin-top:0.35rem;">Login Admin</a>
      <% } %>
    </div>
  </header>

  <main id="konten-utama">
    <section class="hero-section">
      <div class="container hero-grid">
        <div class="t-stagger" id="hero-stagger">
          <div class="t-stagger-line t-stagger-line--1">
            <h1 class="hero-title"><%= appName %></h1>
          </div>
          <div class="t-stagger-line t-stagger-line--2">
            <p class="hero-lead">
              Kumpulan hidangan khas Sulawesi Utara yang diolah dari resep turun-temurun. Hangat untuk jamuan keluarga maupun pesanan acara di Manado, jadi yang moba pesan, pesan jo neh.
            </p>
          </div>
          <div class="t-stagger-line t-stagger-line--3">
            <div class="hero-actions">
              <a href="#produk" class="btn btn-primary">Lihat Daftar Menu</a>
              <button type="button" id="hero-open-chat" class="btn btn-secondary">Pesan via Chat</button>
            </div>
          </div>
          <div class="t-stagger-line t-stagger-line--4">
            <dl class="hero-facts">
              <div class="hero-fact-item">
                <dt>Hidangan di katalog</dt>
                <dd class="mono"><%= produk.length %> menu</dd>
              </div>
              <div class="hero-fact-item">
                <dt>Jam operasional</dt>
                <dd>08.00 sampai 20.00 WITA</dd>
              </div>
              <div class="hero-fact-item">
                <dt>Jangkauan antar</dt>
                <dd>Wilayah Manado (15 km)</dd>
              </div>
            </dl>
          </div>
        </div>

        <figure class="hero-photo-frame" style="margin:0;">
          <div class="hero-photo-viewport">
            <img src="<%= heroPhoto.src %>"
              alt="<%= heroPhoto.alt %>"
              width="<%= heroPhoto.width %>" height="<%= heroPhoto.height %>" fetchpriority="high"
              class="hero-photo-img">
          </div>
          <figcaption class="hero-photo-caption">
            <span class="hero-photo-dish"><%= heroPhoto.caption %></span>
            <span class="hero-photo-note">Masakan rumahan Sulawesi Utara</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <% if (isAdmin) { %>
    <section id="daftar-pesanan" class="section-block">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 class="section-title">Daftar Pesanan Masuk</h2>
            <p class="section-subtitle">Pesanan terbaru ditampilkan lebih dahulu untuk segera diproses dapur.</p>
          </div>
          <div class="section-meta">
            <span class="section-count mono"><%= pesanan.length %> pesanan</span>
          </div>
        </div>

        <% if (pesanan.length === 0) { %>
          <div class="empty-state-box">
            <p class="empty-state-title">Belum ada pesanan masuk</p>
            <p class="empty-state-copy">Pesanan pelanggan yang dikirim melalui asisten chat akan langsung tercatat di daftar ini.</p>
          </div>
        <% } else { %>
          <div class="table-panel">
            <table class="order-table">
              <thead>
                <tr>
                  <th scope="col">Kode dan Pelanggan</th>
                  <th scope="col">Menu</th>
                  <th scope="col">Porsi</th>
                  <th scope="col">Tanggal Acara</th>
                  <th scope="col">Alamat dan Lokasi</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody>
                <% pesanan.forEach(function (item) { %>
                  <tr>
                    <td>
                      <div style="display:flex;align-items:center;gap:0.45rem;flex-wrap:wrap;">
                        <span class="mono" style="font-weight:600;"><%= item.kode_pesanan %></span>
                        <% if (item.status === 'Baru') { %>
                          <span class="chip chip-terracotta">Baru</span>
                        <% } else if (item.status === 'Selesai') { %>
                          <span class="chip chip-herb">Selesai</span>
                        <% } else { %>
                          <span class="chip chip-neutral"><%= item.status %></span>
                        <% } %>
                      </div>
                      <div style="margin-top:0.25rem;color:var(--fg-secondary);"><%= item.nama_pelanggan %></div>
                    </td>
                    <td style="font-weight:600;"><%= item.makanan %></td>
                    <td class="mono"><%= item.jumlah_porsi %></td>
                    <td class="mono"><%= new Date(item.tanggal_acara).toLocaleDateString('id-ID') %></td>
                    <td style="max-width:260px;">
                      <div><%= item.alamat %></div>
                      <% if (item.latitude != null && item.longitude != null) { %>
                        <a class="order-map-link" target="_blank" rel="noopener noreferrer"
                          href="https://www.openstreetmap.org/?mlat=<%= item.latitude %>&mlon=<%= item.longitude %>#map=17/<%= item.latitude %>/<%= item.longitude %>">
                          Lihat titik di peta
                        </a>
                      <% } %>
                    </td>
                    <td>
                      <form data-form-status data-id="<%= item.id_pesanan %>" class="status-form">
                        <label class="sr-only" for="status-<%= item.id_pesanan %>">Status pesanan <%= item.kode_pesanan %></label>
                        <select id="status-<%= item.id_pesanan %>" name="status" class="field-select">
                          <% ['Baru', 'Diproses', 'Selesai'].forEach(function (status) { %>
                            <option value="<%= status %>" <%= item.status === status ? 'selected' : '' %>><%= status %></option>
                          <% }); %>
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm">Simpan</button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
        <p id="hasil-update-status" aria-live="polite" style="margin-top:0.75rem;font-size:0.875rem;color:var(--fg-secondary);"></p>
      </div>
    </section>
    <% } %>

    <section id="produk" class="section-block">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 class="section-title">Menu Dapur Manado</h2>
            <p class="section-subtitle">Pilih hidangan langsung dari buku menu kami, lalu tentukan jumlah porsi serta alamat pengantaran lewat chat.</p>
          </div>
          <div class="section-meta">
            <span class="section-count mono"><%= produk.length %> hidangan</span>
            <% if (isAdmin) { %>
              <button type="button" id="btn-tambah" class="btn btn-primary">Tambah Produk</button>
            <% } %>
          </div>
        </div>

        <% if (produk.length === 0) { %>
          <div class="empty-state-box">
            <p class="empty-state-title">Belum ada hidangan di daftar menu</p>
            <p class="empty-state-copy">Data katalog makanan sedang kosong. Tambahkan menu baru dari akun admin atau cek kembali beberapa saat lagi.</p>
            <div class="empty-state-actions">
              <% if (isAdmin) { %>
                <button type="button" id="btn-tambah-empty" class="btn btn-primary">Tambah Menu Pertama</button>
              <% } else { %>
                <button type="button" id="btn-chat-empty" class="btn btn-secondary">Tanya Lewat Chat</button>
              <% } %>
            </div>
          </div>
        <% } else { %>
          <% if (featuredDish) { %>
            <article class="featured-dish">
              <div class="t-tilt" id="featured-tilt">
                <div class="t-tilt-card featured-media-frame">
                  <img src="<%= featuredPhoto.src %>" alt="<%= featuredPhoto.alt %>"
                    width="<%= featuredPhoto.width %>" height="<%= featuredPhoto.height %>"
                    loading="lazy" class="featured-media-img">
                  <div class="t-tilt-glare" aria-hidden="true"></div>
                </div>
              </div>

              <div class="featured-body">
                <div class="featured-meta-row">
                  <span class="chip chip-terracotta">Sorotan Dapur</span>
                  <% if (Number(featuredDish.stok) > 0) { %>
                    <span class="chip chip-herb">Stok tersedia: <%= featuredDish.stok %></span>
                  <% } else { %>
                    <span class="chip chip-danger">Stok habis</span>
                  <% } %>
                </div>

                <h3 class="featured-title"><%= featuredDish.makanan %></h3>
                <p class="featured-desc"><%= featuredDish.deskripsi %></p>

                <div class="featured-footer">
                  <p class="price-tag price-tag--lg"><%= formatRupiah(featuredDish.harga) %></p>
                  <div class="dish-actions">
                    <% if (!isAdmin) { %>
                      <button type="button"
                        data-order-product="<%= featuredDish.id_makanan %>"
                        data-order-name="<%= featuredDish.makanan %>"
                        class="btn btn-primary">Pesan Hidangan Ini</button>
                    <% } else { %>
                      <button type="button" data-edit
                        data-id="<%= featuredDish.id_makanan %>"
                        data-makanan="<%= featuredDish.makanan %>"
                        data-harga="<%= featuredDish.harga %>"
                        data-stok="<%= featuredDish.stok %>"
                        data-deskripsi="<%= featuredDish.deskripsi %>"
                        class="btn btn-secondary btn-sm">Edit</button>
                      <button type="button" data-hapus
                        data-id="<%= featuredDish.id_makanan %>"
                        data-makanan="<%= featuredDish.makanan %>"
                        class="btn btn-danger-ghost btn-sm">Hapus</button>
                    <% } %>
                  </div>
                </div>
              </div>
            </article>
          <% } %>

          <% if (sisaProduk.length > 0) { %>
            <div class="menu-ledger">
              <% sisaProduk.forEach(function (item) {
                const fotoItem = cariFotoProduk(item.makanan);
              %>
                <article class="menu-row">
                  <% if (fotoItem) { %>
                    <div class="menu-row-thumb">
                      <img src="<%= fotoItem.src %>" alt="<%= fotoItem.alt %>"
                        width="<%= fotoItem.width %>" height="<%= fotoItem.height %>" loading="lazy">
                    </div>
                  <% } %>
                  <div class="menu-row-content">
                    <div class="menu-row-top">
                      <h3 class="menu-row-title"><%= item.makanan %></h3>
                      <% if (Number(item.stok) > 0) { %>
                        <span class="chip chip-herb">Stok <%= item.stok %></span>
                      <% } else { %>
                        <span class="chip chip-danger">Habis</span>
                      <% } %>
                    </div>
                    <p class="menu-row-desc"><%= item.deskripsi %></p>
                    <div class="menu-row-bottom">
                      <p class="price-tag price-tag--md"><%= formatRupiah(item.harga) %></p>
                      <div class="dish-actions">
                        <% if (!isAdmin) { %>
                          <button type="button"
                            data-order-product="<%= item.id_makanan %>"
                            data-order-name="<%= item.makanan %>"
                            class="btn btn-primary btn-sm">Pesan</button>
                        <% } else { %>
                          <button type="button" data-edit
                            data-id="<%= item.id_makanan %>"
                            data-makanan="<%= item.makanan %>"
                            data-harga="<%= item.harga %>"
                            data-stok="<%= item.stok %>"
                            data-deskripsi="<%= item.deskripsi %>"
                            class="btn btn-ghost btn-sm">Edit</button>
                          <button type="button" data-hapus
                            data-id="<%= item.id_makanan %>"
                            data-makanan="<%= item.makanan %>"
                            class="btn btn-danger-ghost btn-sm">Hapus</button>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        <% } %>
      </div>
    </section>

    <section id="galeri" class="section-block section-block--sand">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 class="section-title">Dari Dapur Kami</h2>
            <p class="section-subtitle">Potret sajian asli Sulawesi Utara yang disiapkan hangat sebelum diantar.</p>
          </div>
          <div class="gallery-controls">
            <button type="button" data-galeri="prev" aria-label="Geser galeri ke kiri" class="gallery-icon-btn">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" id="galeri-pause" aria-pressed="false" class="gallery-icon-btn">
              <span id="galeri-pause-label">Jeda</span>
            </button>
            <button type="button" data-galeri="next" aria-label="Geser galeri ke kanan" class="gallery-icon-btn">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>

        <div id="galeri-track" data-unique="<%= galeri.length %>" class="gallery-track no-scrollbar" tabindex="0" aria-label="Galeri foto makanan Manado">
          <% for (let salinan = 0; salinan < 3; salinan++) { %>
            <% galeri.forEach(function (foto) { %>
              <figure class="gallery-card"<% if (salinan > 0) { %> aria-hidden="true"<% } %>>
                <div class="gallery-img-wrap">
                  <img src="<%= foto.src %>" alt="<%= salinan === 0 ? foto.alt : '' %>" width="<%= foto.width %>" height="<%= foto.height %>" loading="lazy">
                </div>
                <figcaption class="gallery-caption"><%= foto.caption %></figcaption>
              </figure>
            <% }); %>
          <% } %>
        </div>
      </div>
    </section>

    <section class="section-block" aria-label="Pelacakan pesanan dan dokumentasi API">
      <div class="container utility-grid">
        <div id="cek-pesanan" class="panel-card">
          <h2 class="section-title" style="font-size:1.55rem;">Cek Status Pesanan</h2>
          <p class="section-subtitle" style="margin-top:0.35rem;">Sudah memesan lewat chat? Masukkan kode pesanan kamu untuk melihat status terbaru dari dapur.</p>

          <form id="form-cek-pesanan" novalidate>
            <div class="lookup-form-row">
              <div class="lookup-field-col t-input-wrap" id="kode-input-wrap">
                <label for="input-kode-pesanan" class="field-label">Kode pesanan</label>
                <input id="input-kode-pesanan" name="kode" required maxlength="16" autocomplete="off"
                  placeholder="Contoh: MAN-A1B2C3D4"
                  class="field-input mono t-input">
                <p id="kode-error-msg" class="t-error-msg">Masukkan kode pesanan terlebih dahulu.</p>
              </div>
              <div class="lookup-submit-col">
                <button type="submit" id="btn-cek-pesanan" class="btn btn-primary" style="width:100%;">Cek Status</button>
              </div>
            </div>
          </form>

          <div id="box-cek-pesanan" class="lookup-status-box" aria-live="polite">
            <span class="lookup-check-slot">
              <span class="t-success-check" id="cek-success-icon" data-state="out" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </span>
            <div class="lookup-result-content">
              <span id="hasil-cek-pesanan" class="t-text-swap">Status pesanan akan tampil di sini setelah kode diperiksa.</span>
              <div id="detail-cek-pesanan" class="lookup-meta-detail" hidden></div>
            </div>
          </div>
        </div>

        <div id="api" class="panel-card">
          <h2 class="section-title" style="font-size:1.55rem;">Endpoint API</h2>
          <p class="section-subtitle" style="margin-top:0.35rem;">Daftar jalur REST JSON aktif untuk mengambil data menu, status server, dan pengelolaan katalog.</p>

          <div class="api-list">
            <% endpoints.forEach(function (ep) {
              const badgeClass = ep.method === 'GET' ? 'http-get' : (ep.method === 'DELETE' ? 'http-delete' : 'http-post');
            %>
              <div class="api-row">
                <div class="api-row-left">
                  <span class="http-badge <%= badgeClass %>"><%= ep.method %></span>
                  <% if (ep.href) { %>
                    <a href="<%= ep.href %>" class="api-path api-path-link"><%= ep.path %></a>
                  <% } else { %>
                    <code class="api-path"><%= ep.path %></code>
                  <% } %>
                </div>
                <div class="api-row-right">
                  <span class="api-desc"><%= ep.desc %></span>
                  <button type="button" class="api-copy-btn" data-copy-path="<%= ep.path %>" aria-label="Salin jalur <%= ep.path %>">Salin</button>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </section>
  </main>

  <% if (isAdmin) { %>
  <div id="modal-produk" class="modal-backdrop" hidden>
    <div id="modal-produk-dialog" class="modal-dialog t-modal" role="dialog" aria-modal="true" aria-labelledby="modal-judul">
      <div class="modal-head">
        <h2 id="modal-judul" class="modal-title">Tambah Produk</h2>
        <button type="button" id="btn-tutup" aria-label="Tutup dialog produk" class="modal-close-btn">&times;</button>
      </div>

      <form id="form-produk" class="modal-form">
        <input type="hidden" name="id">

        <div>
          <label for="input-makanan" class="field-label">Nama makanan</label>
          <input id="input-makanan" name="makanan" required maxlength="50"
            placeholder="Contoh: Cakalang Fufu Rica" class="field-input">
        </div>

        <div class="modal-row-2">
          <div>
            <label for="input-harga" class="field-label">Harga (Rp)</label>
            <input id="input-harga" name="harga" type="number" min="0" required
              placeholder="25000" class="field-input mono">
          </div>
          <div>
            <label for="input-stok" class="field-label">Stok porsi</label>
            <input id="input-stok" name="stok" type="number" min="0" required
              placeholder="20" class="field-input mono">
          </div>
        </div>

        <div>
          <label for="input-deskripsi" class="field-label">Deskripsi</label>
          <textarea id="input-deskripsi" name="deskripsi" rows="3" required maxlength="256"
            placeholder="Tulis bahan utama, cita rasa, atau pelengkap sajian." class="field-textarea"></textarea>
        </div>

        <p id="form-error" role="alert" class="alert-error" style="margin-top:0;" hidden></p>

        <div class="modal-actions">
          <button type="button" id="btn-batal" class="btn btn-secondary">Batal</button>
          <button type="submit" id="btn-simpan-produk" class="btn btn-primary">Simpan</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <section id="chatbot-panel" aria-label="Asisten pemesanan makanan Manado" aria-hidden="true"
    data-open="false" class="chat-panel t-panel-slide">
    <header class="chat-header">
      <div>
        <h2 class="chat-header-title">Chat Makanan Manado</h2>
        <p class="chat-header-sub">Jawaban berdasarkan data katalog aktif</p>
      </div>
      <button id="chat-close" type="button" aria-label="Tutup chatbot" class="chat-close-btn">&times;</button>
    </header>

    <div id="chat-messages"
      data-products="<%= JSON.stringify(produk.map(function (item) { return { id: item.id_makanan, nama: item.makanan, harga: item.harga }; })) %>"
      aria-live="polite" class="chat-feed">
      <p class="chat-bubble chat-bubble--bot">Halo! Ada yang bisa saya bantu mengenai menu makanan khas Manado?</p>
      <div class="chat-quick-row">
        <button type="button" data-chat-quick="menu" class="chat-pill">Lihat Menu</button>
        <button type="button" data-order-start class="chat-pill chat-pill--herb">Pesan Sekarang</button>
      </div>
    </div>

    <form id="chat-form" class="chat-form">
      <label for="chat-input" class="sr-only">Pertanyaan untuk chatbot</label>
      <input id="chat-input" name="message" maxlength="500" required autocomplete="off"
        placeholder="Tulis pertanyaan atau pesanan..." class="field-input" style="flex:1;min-width:0;">
      <button id="chat-send" type="submit" class="btn btn-primary btn-sm">Kirim</button>
    </form>
  </section>

  <button id="chat-toggle" type="button" aria-label="Buka chatbot makanan" aria-expanded="false" class="chat-fab">
    <span class="t-icon-swap" id="chat-fab-icons" data-state="a" aria-hidden="true">
      <span class="t-icon" data-icon="a">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" width="26" height="26">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 9h10M7 13h6m-7 7-3 1 1-4a8 8 0 1 1 3 3Z" />
        </svg>
      </span>
      <span class="t-icon" data-icon="b">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </span>
    </span>
  </button>

  <div id="app-toast" role="status" aria-live="polite" class="app-toast t-toast"></div>

  <script>
    (function () {
      const heroBlock = document.getElementById('hero-stagger');
      if (heroBlock) {
        requestAnimationFrame(() => heroBlock.classList.add('is-shown'));
      }

      const mobileToggle = document.getElementById('mobile-nav-toggle');
      const mobileDrawer = document.getElementById('mobile-nav-drawer');
      if (mobileToggle && mobileDrawer) {
        function setDrawer(open) {
          mobileToggle.setAttribute('aria-expanded', String(open));
          mobileToggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
          mobileDrawer.hidden = !open;
          mobileDrawer.classList.toggle('is-open', open);
        }
        mobileToggle.addEventListener('click', () => setDrawer(mobileDrawer.hidden));
        mobileDrawer.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setDrawer(false));
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !mobileDrawer.hidden) {
            setDrawer(false);
            mobileToggle.focus();
          }
        });
      }

      const toast = document.getElementById('app-toast');
      let toastTimer = null;
      window.showNusantaraToast = function (text) {
        if (!toast) return;
        toast.textContent = text;
        toast.classList.add('is-open');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('is-open'), 2400);
      };

      document.querySelectorAll('[data-copy-path]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const pathText = btn.dataset.copyPath;
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              await navigator.clipboard.writeText(pathText);
            }
            window.showNusantaraToast(`Disalin: ${pathText}`);
          } catch (_) {
            window.showNusantaraToast(`Jalur endpoint: ${pathText}`);
          }
        });
      });

      const tilt = document.getElementById('featured-tilt');
      if (tilt) {
        const card = tilt.querySelector('.t-tilt-card');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        const MAX = 10;

        function resetTilt() {
          tilt.classList.remove('is-hover');
          card.classList.remove('is-tilting');
          card.style.setProperty('--tilt-rx', '0deg');
          card.style.setProperty('--tilt-ry', '0deg');
        }
        function trackTilt(e) {
          if (reduce.matches) return;
          const r = tilt.getBoundingClientRect();
          const px = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
          const py = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
          tilt.classList.add('is-hover');
          card.classList.add('is-tilting');
          card.style.setProperty('--tilt-ry', ((px - 0.5) * MAX).toFixed(2) + 'deg');
          card.style.setProperty('--tilt-rx', ((0.5 - py) * MAX).toFixed(2) + 'deg');
          card.style.setProperty('--tilt-gx', (px * 100).toFixed(1) + '%');
          card.style.setProperty('--tilt-gy', (py * 100).toFixed(1) + '%');
        }
        tilt.addEventListener('pointerdown', (e) => {
          if (e.pointerType !== 'mouse') {
            try { tilt.setPointerCapture(e.pointerId); } catch (_) {}
          }
        });
        tilt.addEventListener('pointermove', trackTilt);
        tilt.addEventListener('pointerup', resetTilt);
        tilt.addEventListener('pointercancel', resetTilt);
        tilt.addEventListener('pointerleave', (e) => {
          if (e.pointerType === 'mouse') resetTilt();
        });
      }
    })();
  </script>

  <script>
    (function () {
      const track = document.getElementById('galeri-track');
      const prev = document.querySelector('[data-galeri="prev"]');
      const next = document.querySelector('[data-galeri="next"]');
      const pauseBtn = document.getElementById('galeri-pause');
      const pauseLabel = document.getElementById('galeri-pause-label');
      if (!track || !prev || !next || !pauseBtn) return;

      const slides = Array.from(track.children);
      const unique = Number(track.dataset.unique) || 1;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let userPaused = reduceMotion.matches;
      let hoverPaused = false;
      let resumeTimer = null;

      function syncPauseButton() {
        pauseBtn.setAttribute('aria-pressed', String(userPaused));
        pauseLabel.textContent = userPaused ? 'Lanjutkan' : 'Jeda';
      }
      syncPauseButton();

      function getLoopWidth() {
        return slides[unique] ? slides[unique].offsetLeft - slides[0].offsetLeft : 0;
      }

      function autoScroll() {
        const loopWidth = getLoopWidth();
        if (!userPaused && !hoverPaused && !reduceMotion.matches && loopWidth > 0) {
          track.scrollLeft += 0.6;
          if (track.scrollLeft >= loopWidth) track.scrollLeft -= loopWidth;
        }
        requestAnimationFrame(autoScroll);
      }

      function pauseSementara() {
        hoverPaused = true;
        clearTimeout(resumeTimer);
        resumeTimer = setTimeout(() => { hoverPaused = false; }, 1800);
      }

      pauseBtn.addEventListener('click', () => {
        userPaused = !userPaused;
        syncPauseButton();
      });

      track.addEventListener('mouseenter', () => { hoverPaused = true; });
      track.addEventListener('mouseleave', () => { hoverPaused = false; });
      track.addEventListener('touchstart', pauseSementara, { passive: true });

      function geser(arah) {
        pauseSementara();
        const step = (slides[0] ? slides[0].offsetWidth : 280) + 18;
        track.scrollBy({ left: arah * step, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      }

      prev.addEventListener('click', () => geser(-1));
      next.addEventListener('click', () => geser(1));

      requestAnimationFrame(autoScroll);
    })();
  </script>

  <script>
    (function () {
      const backdrop = document.getElementById('modal-produk');
      const dialog = document.getElementById('modal-produk-dialog');
      const form = document.getElementById('form-produk');
      const judul = document.getElementById('modal-judul');
      const errorBox = document.getElementById('form-error');
      const btnTambah = document.getElementById('btn-tambah');
      const btnTambahEmpty = document.getElementById('btn-tambah-empty');
      const btnSimpan = document.getElementById('btn-simpan-produk');
      if (!backdrop || !dialog || !form) return;

      const closeMs = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue('--modal-close-dur')
      ) || 150;
      let lastTrigger = null;

      function bukaModal(produk, triggerEl) {
        lastTrigger = triggerEl || document.activeElement;
        form.reset();
        errorBox.hidden = true;
        form.elements.id.value = produk ? produk.id : '';
        form.elements.makanan.value = produk ? produk.makanan : '';
        form.elements.harga.value = produk ? produk.harga : '';
        form.elements.stok.value = produk ? produk.stok : '';
        form.elements.deskripsi.value = produk ? produk.deskripsi : '';
        judul.textContent = produk ? 'Edit Produk' : 'Tambah Produk';

        backdrop.hidden = false;
        dialog.classList.remove('is-closing');
        void dialog.offsetWidth;
        backdrop.classList.add('is-open');
        dialog.classList.add('is-open');
        form.elements.makanan.focus();
      }

      function tutupModal() {
        backdrop.classList.remove('is-open');
        dialog.classList.remove('is-open');
        dialog.classList.add('is-closing');
        setTimeout(() => {
          dialog.classList.remove('is-closing');
          backdrop.hidden = true;
          if (lastTrigger && typeof lastTrigger.focus === 'function') lastTrigger.focus();
        }, closeMs);
      }

      if (btnTambah) btnTambah.addEventListener('click', () => bukaModal(null, btnTambah));
      if (btnTambahEmpty) btnTambahEmpty.addEventListener('click', () => bukaModal(null, btnTambahEmpty));
      document.getElementById('btn-tutup').addEventListener('click', tutupModal);
      document.getElementById('btn-batal').addEventListener('click', tutupModal);

      backdrop.addEventListener('click', (event) => {
        if (event.target === backdrop) tutupModal();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !backdrop.hidden) tutupModal();
      });

      document.querySelectorAll('[data-edit]').forEach((tombol) => {
        tombol.addEventListener('click', () => bukaModal(tombol.dataset, tombol));
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorBox.hidden = true;
        btnSimpan.disabled = true;
        btnSimpan.textContent = 'Menyimpan...';

        const data = Object.fromEntries(new FormData(form));
        const id = data.id;
        delete data.id;

        try {
          const response = await fetch(id ? `/api/produk/${id}` : '/api/produk', {
            method: id ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
            body: JSON.stringify(data),
          });
          const hasil = await response.json();

          if (!response.ok) {
            errorBox.textContent = hasil.message || 'Gagal menyimpan produk.';
            errorBox.hidden = false;
            return;
          }

          window.location.reload();
        } catch (_) {
          errorBox.textContent = 'Tidak bisa menghubungi server. Periksa koneksi lalu coba simpan lagi.';
          errorBox.hidden = false;
        } finally {
          btnSimpan.disabled = false;
          btnSimpan.textContent = 'Simpan';
        }
      });

      document.querySelectorAll('[data-hapus]').forEach((tombol) => {
        tombol.addEventListener('click', async () => {
          if (!confirm(`Hapus "${tombol.dataset.makanan}" dari daftar menu?`)) return;

          try {
            const response = await fetch(`/api/produk/${tombol.dataset.id}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': '<%= csrfToken %>' },
            });

            if (!response.ok) {
              window.showNusantaraToast('Gagal menghapus produk.');
              return;
            }

            window.location.reload();
          } catch (_) {
            window.showNusantaraToast('Tidak bisa menghubungi server.');
          }
        });
      });
    })();
  </script>

  <script>
    (function () {
      const formCek = document.getElementById('form-cek-pesanan');
      const wrap = document.getElementById('kode-input-wrap');
      const inputKode = document.getElementById('input-kode-pesanan');
      const errorMsg = document.getElementById('kode-error-msg');
      const btnCek = document.getElementById('btn-cek-pesanan');
      const boxHasil = document.getElementById('box-cek-pesanan');
      const hasilCek = document.getElementById('hasil-cek-pesanan');
      const detailCek = document.getElementById('detail-cek-pesanan');
      const checkWrap = document.getElementById('cek-success-icon');

      if (checkWrap) {
        const path = checkWrap.querySelector('svg path');
        if (path && typeof path.getTotalLength === 'function') {
          const len = Math.ceil(path.getTotalLength()) + 1;
          path.style.strokeDasharray = String(len);
          path.style.strokeDashoffset = String(len);
        }
      }

      const cs = getComputedStyle(document.documentElement);
      const readMs = (name, fb) => {
        const v = parseFloat(cs.getPropertyValue(name));
        return Number.isFinite(v) ? v : fb;
      };
      const swapDur = readMs('--text-swap-dur', 150);

      function swapStatusText(nextText) {
        if (!hasilCek) return;
        hasilCek.classList.add('is-exit');
        setTimeout(() => {
          hasilCek.textContent = nextText;
          hasilCek.classList.remove('is-exit');
          hasilCek.classList.add('is-enter-start');
          void hasilCek.offsetHeight;
          hasilCek.classList.remove('is-enter-start');
        }, swapDur);
      }

      function triggerShakeError(msg) {
        errorMsg.textContent = msg;
        wrap.classList.add('is-error');
        inputKode.classList.add('is-error');
        inputKode.classList.remove('is-shaking');
        void inputKode.offsetWidth;
        inputKode.classList.add('is-shaking');

        const shakeMs = readMs('--shake-dur-a', 80) * 2 + readMs('--shake-dur-b', 60) * 2;
        setTimeout(() => inputKode.classList.remove('is-shaking'), shakeMs + 20);

        if (wrap._revertTimer) clearTimeout(wrap._revertTimer);
        const hold = readMs('--revert-hold', 3500);
        wrap._revertTimer = setTimeout(() => {
          wrap._revertTimer = null;
          wrap.classList.remove('is-error');
          inputKode.classList.remove('is-error');
        }, shakeMs + hold);
      }

      if (inputKode) {
        inputKode.addEventListener('input', () => {
          if (wrap._revertTimer) {
            clearTimeout(wrap._revertTimer);
            wrap._revertTimer = null;
          }
          wrap.classList.remove('is-error');
          inputKode.classList.remove('is-error');
        });
      }

      if (formCek) {
        formCek.addEventListener('submit', async (event) => {
          event.preventDefault();
          const kode = String(inputKode.value || '').trim();
          if (wrap._revertTimer) {
            clearTimeout(wrap._revertTimer);
            wrap._revertTimer = null;
          }
          wrap.classList.remove('is-error');
          inputKode.classList.remove('is-error', 'is-shaking');
          boxHasil.classList.remove('is-found', 'is-not-found');
          detailCek.hidden = true;
          checkWrap.setAttribute('data-state', 'out');

          if (!kode) {
            triggerShakeError('Masukkan kode pesanan, contoh MAN-A1B2C3D4.');
            boxHasil.classList.add('is-not-found');
            swapStatusText('Kode pesanan belum diisi. Masukkan kode dari chat konfirmasi pesanan.');
            inputKode.focus();
            return;
          }

          btnCek.disabled = true;
          btnCek.textContent = 'Memeriksa...';
          swapStatusText('Memeriksa kode pesanan di dapur...');

          try {
            const response = await fetch(`/api/pesanan/status/${encodeURIComponent(kode)}`);
            const result = await response.json();
            if (response.ok && result.data) {
              boxHasil.classList.add('is-found');
              swapStatusText(`Pesanan ${result.data.kode_pesanan}: ${result.data.status}`);
              if (result.data.dibuat_pada) {
                const waktu = new Date(result.data.dibuat_pada).toLocaleString('id-ID', {
                  dateStyle: 'medium',
                  timeStyle: 'short',
                });
                detailCek.textContent = `Dicatat pada ${waktu}`;
                detailCek.hidden = false;
              }
              checkWrap.setAttribute('data-state', 'out');
              void checkWrap.offsetWidth;
              checkWrap.setAttribute('data-state', 'in');
            } else {
              const pesan = result.message || 'Kode pesanan tidak ditemukan.';
              boxHasil.classList.add('is-not-found');
              triggerShakeError(pesan);
              swapStatusText(`${pesan} Pastikan huruf dan angka kode sudah sesuai.`);
            }
          } catch (_) {
            boxHasil.classList.add('is-not-found');
            triggerShakeError('Tidak bisa menghubungi server.');
            swapStatusText('Tidak bisa menghubungi server. Coba periksa koneksi lalu ulangi.');
          } finally {
            btnCek.disabled = false;
            btnCek.textContent = 'Cek Status';
          }
        });
      }

      const hasilUpdate = document.getElementById('hasil-update-status');
      document.querySelectorAll('[data-form-status]').forEach((form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const submitBtn = form.querySelector('button[type="submit"]');
          const status = new FormData(form).get('status');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Menyimpan...';
          }
          try {
            const response = await fetch(`/api/pesanan/${form.dataset.id}/status`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
              body: JSON.stringify({ status }),
            });
            const result = await response.json();
            if (!response.ok) {
              if (hasilUpdate) hasilUpdate.textContent = result.message || 'Gagal memperbarui status pesanan.';
              return;
            }
            window.location.reload();
          } catch (_) {
            if (hasilUpdate) hasilUpdate.textContent = 'Tidak bisa menghubungi server.';
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Simpan';
            }
          }
        });
      });
    })();
  </script>

  <script>
    (function () {
      const panel = document.getElementById('chatbot-panel');
      const toggle = document.getElementById('chat-toggle');
      const fabIcons = document.getElementById('chat-fab-icons');
      const close = document.getElementById('chat-close');
      const form = document.getElementById('chat-form');
      const input = document.getElementById('chat-input');
      const messages = document.getElementById('chat-messages');
      const send = document.getElementById('chat-send');
      const heroOpenChat = document.getElementById('hero-open-chat');
      const emptyOpenChat = document.getElementById('btn-chat-empty');
      const products = JSON.parse(messages.dataset.products || '[]');

      let orderStep = null;
      let orderDraft = null;
      let activeMap = null;
      let activeMapElement = null;
      const batasAntarMeter = 15000;

      function isPanelOpen() {
        return panel.getAttribute('data-open') === 'true';
      }

      function setOpen(open) {
        panel.setAttribute('data-open', String(open));
        panel.setAttribute('aria-hidden', String(!open));
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Tutup chatbot makanan' : 'Buka chatbot makanan');
        if (fabIcons) fabIcons.setAttribute('data-state', open ? 'b' : 'a');
        if (open) {
          setTimeout(() => input.focus(), 60);
        }
      }

      function tambahPesan(text, fromUser, useShimmer) {
        const bubble = document.createElement('p');
        bubble.className = fromUser
          ? 'chat-bubble chat-bubble--user'
          : 'chat-bubble chat-bubble--bot';
        if (useShimmer) {
          const span = document.createElement('span');
          span.className = 't-shimmer';
          span.dataset.text = text;
          span.textContent = text;
          bubble.appendChild(span);
        } else {
          bubble.textContent = text;
        }
        messages.appendChild(bubble);
        messages.scrollTop = messages.scrollHeight;
        return bubble;
      }

      function tombolPilihan(label, attributes, variantClass) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = variantClass ? `chat-pill ${variantClass}` : 'chat-pill';
        button.textContent = label;
        Object.entries(attributes).forEach(([key, value]) => button.dataset[key] = value);
        messages.appendChild(button);
        messages.scrollTop = messages.scrollHeight;
      }

      function tampilkanPilihanMenu() {
        if (!products.length) {
          tambahPesan('Belum ada menu yang bisa dipesan. Silakan coba lagi nanti.', false);
          orderStep = null;
          return;
        }
        tambahPesan('Pilih menu yang ingin dipesan:', false);
        const row = document.createElement('div');
        row.className = 'chat-quick-row';
        products.forEach((product) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'chat-pill';
          const hargaStr = new Intl.NumberFormat('id-ID', {
            style: 'currency',
            currency: 'IDR',
            maximumFractionDigits: 0,
          }).format(Number(product.harga));
          button.textContent = `${product.nama}: ${hargaStr}`;
          button.dataset.orderMenu = String(product.id);
          row.appendChild(button);
        });
        messages.appendChild(row);
        messages.scrollTop = messages.scrollHeight;
      }

      function tampilkanPetaAlamat() {
        if (typeof L === 'undefined') {
          tambahPesan('Peta belum siap dimuat. Ketik alamat lengkap area Manado secara manual di chat.', false);
          return;
        }
        if (activeMap) activeMap.remove();
        if (activeMapElement) activeMapElement.remove();

        const wrapper = document.createElement('div');
        wrapper.className = 'chat-map-card';
        const instruksi = document.createElement('p');
        instruksi.textContent = 'Pilih titik di peta jika tampil. Jika tidak, ketik alamat atau patokan lengkap wilayah Manado di chat.';
        const mapElement = document.createElement('div');
        mapElement.className = 'chat-map-box';
        const statusLokasi = document.createElement('p');
        statusLokasi.className = 'chat-map-status';
        statusLokasi.textContent = 'Titik lokasi belum dipilih.';
        wrapper.append(instruksi, mapElement, statusLokasi);
        messages.appendChild(wrapper);
        activeMapElement = wrapper;

        const manadoCenter = L.latLng(1.482384, 124.840379);
        const lingkaran = L.circle(manadoCenter, {
          radius: batasAntarMeter,
          color: '#B45309',
          fillColor: '#B45309',
          fillOpacity: 0.08,
        });
        const map = L.map(mapElement, {
          scrollWheelZoom: false,
          maxBounds: lingkaran.getBounds(),
          maxBoundsViscosity: 1,
        }).setView(manadoCenter, 14);
        activeMap = map;
        statusLokasi.textContent = 'Menyiapkan peta area Manado...';

        const tiles = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>',
        });
        let jumlahTileMasuk = 0;
        let jumlahTileGagal = 0;
        tiles.on('tileload', () => { jumlahTileMasuk += 1; });
        tiles.on('loading', () => {
          statusLokasi.textContent = 'Memuat peta OpenStreetMap...';
        });
        tiles.on('load', () => {
          statusLokasi.textContent = 'Peta siap. Klik titik pengantaran di dalam lingkaran.';
        });
        tiles.on('tileerror', () => {
          jumlahTileGagal += 1;
          statusLokasi.textContent = 'Tile peta gagal dimuat. Kamu tetap bisa mengetik alamat wilayah Manado secara manual.';
        });
        tiles.addTo(map);
        lingkaran.addTo(map);

        const pinSvg = '<svg width="26" height="30" viewBox="0 0 24 28" fill="none" aria-hidden="true"><path d="M12 1C6.48 1 2 5.48 2 11c0 7.1 10 16 10 16s10-8.9 10-16c0-5.52-4.48-10-10-10Z" fill="#B45309" stroke="#FFFFFF" stroke-width="2"/><circle cx="12" cy="11" r="3.5" fill="#FFFFFF"/></svg>';

        let marker = null;
        let lokasiValidTerakhir = null;
        function pilihTitik(latlng) {
          if (map.distance(manadoCenter, latlng) > batasAntarMeter) {
            statusLokasi.textContent = 'Titik di luar area pengantaran Manado. Pilih titik di dalam lingkaran.';
            return false;
          }
          if (!marker) {
            marker = L.marker(latlng, {
              draggable: true,
              icon: L.divIcon({
                className: 'manado-map-pin',
                html: pinSvg,
                iconSize: [26, 30],
                iconAnchor: [13, 29],
              }),
            }).addTo(map);
            marker.on('dragend', () => {
              const titik = marker.getLatLng();
              if (!pilihTitik(titik)) marker.setLatLng(lokasiValidTerakhir);
            });
          } else {
            marker.setLatLng(latlng);
          }
          lokasiValidTerakhir = latlng;
          orderDraft.latitude = latlng.lat;
          orderDraft.longitude = latlng.lng;
          statusLokasi.textContent = `Lokasi dipilih: ${latlng.lat.toFixed(6)}, ${latlng.lng.toFixed(6)}. Pin bisa digeser.`;
          return true;
        }
        map.on('click', (event) => pilihTitik(event.latlng));
        requestAnimationFrame(() => map.invalidateSize({ pan: false }));
        setTimeout(() => {
          map.invalidateSize({ pan: false });
          if (jumlahTileMasuk === 0 && jumlahTileGagal === 0) {
            statusLokasi.textContent = 'Peta belum menerima tile. Kamu bisa mengetik alamat wilayah Manado secara manual di bawah.';
          }
        }, 1800);
        messages.scrollTop = messages.scrollHeight;
      }

      function mulaiPesanan(idProduct) {
        if (activeMap) activeMap.remove();
        if (activeMapElement) activeMapElement.remove();
        activeMap = null;
        activeMapElement = null;
        orderDraft = {};
        if (idProduct) {
          const product = products.find((item) => String(item.id) === String(idProduct));
          if (!product) {
            tambahPesan('Menu tidak ditemukan. Silakan muat ulang halaman.', false);
            return;
          }
          orderDraft.product = product;
          orderStep = 'jumlah';
          tambahPesan(`Kamu memilih ${product.nama}. Berapa jumlah porsi yang ingin dipesan?`, false);
          return;
        }
        orderStep = 'menu';
        tampilkanPilihanMenu();
      }

      function formatTanggal(tanggal) {
        const [tahun, bulan, hari] = tanggal.split('-');
        const nilai = new Date(Date.UTC(Number(tahun), Number(bulan) - 1, Number(hari)));
        return /^\d{4}-\d{2}-\d{2}$/.test(tanggal) && nilai.toISOString().slice(0, 10) === tanggal;
      }

      async function prosesJawabanPesanan(message) {
        const jawaban = message.trim();
        if (orderStep === 'menu') {
          const product = products.find((item) => String(item.id) === jawaban || item.nama.toLocaleLowerCase('id-ID') === jawaban.toLocaleLowerCase('id-ID'));
          if (!product) { tambahPesan('Pilih menu dari tombol yang tersedia atau ketik nama menu dengan tepat.', false); return; }
          orderDraft.product = product;
          orderStep = 'jumlah';
          tambahPesan('Berapa jumlah porsi yang ingin dipesan?', false);
        } else if (orderStep === 'jumlah') {
          const jumlah = Number(jawaban);
          if (!Number.isInteger(jumlah) || jumlah < 1 || jumlah > 10000) { tambahPesan('Masukkan jumlah porsi berupa angka bulat minimal 1.', false); return; }
          orderDraft.jumlah = jumlah;
          orderStep = 'tanggal';
          tambahPesan('Tanggal acara kapan? Gunakan format YYYY-MM-DD, contoh 2026-12-25.', false);
        } else if (orderStep === 'tanggal') {
          if (!formatTanggal(jawaban)) { tambahPesan('Format tanggal belum valid. Gunakan YYYY-MM-DD, contoh 2026-12-25.', false); return; }
          orderDraft.tanggal = jawaban;
          orderStep = 'nama';
          tambahPesan('Siapa nama pemesan?', false);
        } else if (orderStep === 'nama') {
          if (!jawaban || jawaban.length > 100) { tambahPesan('Nama wajib diisi dan maksimal 100 karakter.', false); return; }
          orderDraft.nama = jawaban;
          orderStep = 'alamat';
          tambahPesan('Atur lokasi pengantaran. Kamu bisa memilih titik di peta atau mengetik alamat secara manual.', false);
          tampilkanPetaAlamat();
        } else if (orderStep === 'alamat') {
          if (!jawaban || jawaban.length > 500) { tambahPesan('Alamat wajib diisi dan maksimal 500 karakter.', false); return; }
          orderDraft.alamat = jawaban;
          orderStep = 'konfirmasi';
          const total = Number(orderDraft.product.harga) * orderDraft.jumlah;
          const rupiah = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(total);
          const titikPeta = Number.isFinite(orderDraft.latitude) && Number.isFinite(orderDraft.longitude)
            ? `${orderDraft.latitude.toFixed(6)}, ${orderDraft.longitude.toFixed(6)}`
            : 'tidak dipilih (alamat diisi manual)';
          tambahPesan(`Rangkuman pesanan:\nNama: ${orderDraft.nama}\nMenu: ${orderDraft.product.nama}\nJumlah: ${orderDraft.jumlah} porsi\nTanggal: ${orderDraft.tanggal}\nAlamat: ${orderDraft.alamat}\nTitik peta: ${titikPeta}\nTotal: ${rupiah}\n\nKetik "Ya" untuk menyimpan atau "Ubah" untuk mengisi ulang.`, false);
          const row = document.createElement('div');
          row.className = 'chat-quick-row';
          const btnYa = document.createElement('button');
          btnYa.type = 'button';
          btnYa.className = 'chat-pill chat-pill--herb';
          btnYa.textContent = 'Ya, konfirmasi';
          btnYa.dataset.orderAction = 'ya';
          const btnUbah = document.createElement('button');
          btnUbah.type = 'button';
          btnUbah.className = 'chat-pill';
          btnUbah.textContent = 'Ubah pesanan';
          btnUbah.dataset.orderAction = 'ubah';
          row.append(btnYa, btnUbah);
          messages.appendChild(row);
          messages.scrollTop = messages.scrollHeight;
        } else if (orderStep === 'konfirmasi') {
          if (/^ubah$/i.test(jawaban)) {
            tambahPesan('Baik, kita mulai ulang pesanan.', false);
            mulaiPesanan();
          } else if (/^ya$/i.test(jawaban)) {
            await kirimPesanan();
          } else {
            tambahPesan('Pilih "Ya, konfirmasi" untuk menyimpan atau "Ubah pesanan" untuk mengulang.', false);
          }
        }
      }

      async function kirimPesanan() {
        try {
          const response = await fetch('/api/pesanan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              nama: orderDraft.nama,
              id_makanan: orderDraft.product.id,
              jumlah: orderDraft.jumlah,
              tanggal_acara: orderDraft.tanggal,
              alamat: orderDraft.alamat,
              latitude: orderDraft.latitude ?? null,
              longitude: orderDraft.longitude ?? null,
              lokasi_manual: !Number.isFinite(orderDraft.latitude) || !Number.isFinite(orderDraft.longitude),
            }),
          });
          const result = await response.json();
          if (!response.ok) { tambahPesan(result.message || 'Pesanan gagal disimpan. Silakan coba lagi.', false); return; }
          orderStep = null;
          orderDraft = null;
          tambahPesan(`Pesanan berhasil dicatat. Kode pesanan kamu: ${result.data.kode_pesanan}. Simpan kode ini untuk mengecek status pesanan di bagian bawah halaman.`, false);
        } catch (_) {
          tambahPesan('Tidak bisa menghubungi server. Pesanan belum tersimpan, silakan coba lagi.', false);
        }
      }

      toggle.addEventListener('click', () => setOpen(!isPanelOpen()));
      close.addEventListener('click', () => {
        setOpen(false);
        toggle.focus();
      });

      if (heroOpenChat) {
        heroOpenChat.addEventListener('click', () => {
          setOpen(true);
          if (!orderStep) {
            tambahPesan('Saya ingin memesan makanan.', true);
            mulaiPesanan();
          }
        });
      }

      if (emptyOpenChat) {
        emptyOpenChat.addEventListener('click', () => setOpen(true));
      }

      messages.addEventListener('click', (event) => {
        const startButton = event.target.closest('[data-order-start]');
        if (startButton) { tambahPesan('Saya ingin memesan.', true); mulaiPesanan(); return; }
        const menuButton = event.target.closest('[data-order-menu]');
        if (menuButton) {
          const product = products.find((item) => String(item.id) === menuButton.dataset.orderMenu);
          if (product) {
            tambahPesan(product.nama, true);
            prosesJawabanPesanan(String(product.id));
          }
          return;
        }
        const actionButton = event.target.closest('[data-order-action]');
        if (actionButton) {
          const action = actionButton.dataset.orderAction;
          tambahPesan(action === 'ya' ? 'Ya' : 'Ubah', true);
          prosesJawabanPesanan(action);
          return;
        }
        const quickButton = event.target.closest('[data-chat-quick]');
        if (!quickButton) return;
        input.value = quickButton.dataset.chatQuick;
        form.requestSubmit();
      });

      document.querySelectorAll('[data-order-product]').forEach((button) => {
        button.addEventListener('click', () => {
          setOpen(true);
          const namaProduk = button.dataset.orderName || 'menu pilihan';
          tambahPesan(`Saya ingin memesan ${namaProduk}.`, true);
          mulaiPesanan(button.dataset.orderProduct);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isPanelOpen()) {
          setOpen(false);
          toggle.focus();
        }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const message = input.value.trim();
        if (!message) return;
        tambahPesan(message, true);
        input.value = '';
        if (orderStep) { prosesJawabanPesanan(message); return; }

        input.disabled = true;
        send.disabled = true;
        send.textContent = '...';
        const pending = tambahPesan('Sedang mencari di data makanan...', false, true);

        try {
          const response = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message }),
          });
          const result = await response.json();
          pending.textContent = result.reply || result.message || 'Maaf, chatbot sedang tidak bisa menjawab.';
        } catch (_) {
          pending.textContent = 'Tidak bisa menghubungi server. Coba lagi nanti.';
        } finally {
          input.disabled = false;
          send.disabled = false;
          send.textContent = 'Kirim';
          input.focus();
          messages.scrollTop = messages.scrollHeight;
        }
      });
    })();
  </script>

