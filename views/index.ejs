<%- include('partials/head', { appName }) %>

<%
const galeri = [
  { src: '/images/tinutuan.jpg', alt: 'Semangkuk tinutuan khas Manado' },
  { src: '/images/cakalang-dabu-dabu.jpg', alt: 'Ikan cakalang dengan sambal dabu-dabu' },
  { src: '/images/cakalang-fufu.png', alt: 'Cakalang fufu yang diasap' },
  { src: '/images/dabu-dabu.jpg', alt: 'Sambal dabu-dabu dalam mangkuk batu' },
  { src: '/images/nasi-kuning.jpg', alt: 'Nasi kuning dengan lauk khas Manado' },
];
%>

  <header class="border-b border-stone-200 bg-white">
    <nav class="px-6 lg:px-10 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-amber-700"></span>
        <%= appName %>
      </a>
      <div class="flex items-center gap-6 text-sm text-stone-600">
        <a href="/" class="hover:text-stone-900">Dashboard</a>
        <% if (isAdmin) { %>
          <form action="/admin/logout" method="post"><button class="hover:text-stone-900">Logout Admin</button></form>
        <% } else { %>
          <a href="/admin/login" class="hover:text-stone-900">Login Admin</a>
        <% } %>
      </div>
    </nav>
  </header>

  <main>
    <section class="px-6 lg:px-10 pt-16 pb-12">
      <p class="text-xs font-medium uppercase tracking-widest text-amber-700">Kuliner Sulawesi Utara</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight"><%= appName %></h1>
      <p class="mt-4 max-w-2xl text-stone-600 leading-relaxed">
        Kumpulan hidangan khas Manado yang diolah dari resep yang sudah turun-temurun. jadi yang moba pesan pesan jo neh.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#produk" class="inline-flex items-center rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-800">
          Lihat Produk
        </a>
        <a href="/api/produk" class="inline-flex items-center rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:border-stone-400">
          Endpoint produk</a>
      </div>
    </section>

    <section id="cek-pesanan" class="px-6 lg:px-10 py-8">
      <div class="max-w-xl border-b border-stone-200 pb-4">
        <h2 class="text-xl font-semibold tracking-tight">Cek Status Pesanan</h2>
        <p class="mt-1 text-sm text-stone-500">Masukkan kode pesanan untuk melihat status terbaru.</p>
        <form id="form-cek-pesanan" class="mt-4 flex gap-2">
          <input name="kode" required maxlength="16" placeholder="Contoh: MAN-A1B2C3D4"
            class="min-w-0 flex-1 rounded-md border border-stone-300 px-3 py-2 text-sm">
          <button class="rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white">Cek</button>
        </form>
        <p id="hasil-cek-pesanan" aria-live="polite" class="mt-3 text-sm text-stone-600"></p>
      </div>
    </section>

    <% if (isAdmin) { %>
    <section id="daftar-pesanan" class="px-6 lg:px-10 py-8">
      <div class="border-b border-stone-200 pb-4">
        <h2 class="text-xl font-semibold tracking-tight">Daftar Pesanan</h2>
        <p class="mt-1 text-sm text-stone-500">Pesanan terbaru ditampilkan lebih dahulu.</p>
      </div>
      <% if (pesanan.length === 0) { %>
        <p class="mt-5 text-sm text-stone-500">Belum ada pesanan masuk.</p>
      <% } else { %>
      <div class="mt-5 overflow-x-auto rounded-lg border border-stone-200 bg-white">
        <table class="w-full min-w-[850px] text-left text-sm">
          <thead class="bg-stone-50 text-stone-600"><tr>
            <th class="p-3">Kode / Pelanggan</th><th class="p-3">Menu</th><th class="p-3">Porsi</th>
            <th class="p-3">Tanggal acara</th><th class="p-3">Alamat</th><th class="p-3">Status</th>
          </tr></thead>
          <tbody class="divide-y divide-stone-100">
          <% pesanan.forEach(function (item) { %>
            <tr>
              <td class="p-3"><div class="font-medium"><%= item.kode_pesanan %> <% if (item.status === 'Baru') { %><span class="ml-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">Baru</span><% } %></div><div class="mt-1 text-stone-500"><%= item.nama_pelanggan %></div></td>
              <td class="p-3"><%= item.makanan %></td><td class="p-3"><%= item.jumlah_porsi %></td>
              <td class="p-3"><%= new Date(item.tanggal_acara).toLocaleDateString('id-ID') %></td>
              <td class="max-w-xs p-3"><%= item.alamat %></td>
              <td class="p-3"><form data-form-status data-id="<%= item.id_pesanan %>" class="flex gap-2">
                <select name="status" class="rounded border border-stone-300 px-2 py-1">
                  <% ['Baru', 'Diproses', 'Selesai'].forEach(function (status) { %><option value="<%= status %>" <%= item.status === status ? 'selected' : '' %>><%= status %></option><% }); %>
                </select><button class="rounded bg-stone-900 px-3 py-1 text-white">Simpan</button>
              </form></td>
            </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
      <p id="hasil-update-status" aria-live="polite" class="mt-3 text-sm text-stone-600"></p>
    </section>
    <% } %>

    <section id="produk" class="px-6 lg:px-10 py-8">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-stone-200 pb-4">
        <h2 class="text-xl font-semibold tracking-tight">Daftar Produk</h2>
        <div class="flex items-center gap-4">
          <span class="text-sm text-stone-500"><%= produk.length %> produk</span>
          <% if (isAdmin) { %>
            <button type="button" id="btn-tambah" class="rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-800">Tambah Produk</button>
          <% } %>
        </div>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
        <% produk.forEach(function (item) { %>
          <article class="flex flex-col rounded-lg border border-stone-200 bg-white p-5">
            <span class="text-xs font-medium uppercase tracking-wide text-stone-500">Stok: <%= item.stok %></span>
            <h3 class="mt-3 text-lg font-medium"><%= item.makanan %></h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600"><%= item.deskripsi %></p>
            <div class="mt-4 flex items-center justify-between border-t border-stone-100 pt-3">
              <p class="text-sm font-semibold"><%= formatRupiah(item.harga) %></p>
              <div class="flex items-center gap-3">
                <% if (!isAdmin) { %><button type="button" data-order-product="<%= item.id_makanan %>"
                  class="rounded-md bg-amber-700 px-3 py-1.5 text-xs font-medium text-white hover:bg-amber-800">Pesan</button><% } %>
              <% if (isAdmin) { %><div class="flex items-center gap-3 text-xs">
                <button type="button" data-edit
                  data-id="<%= item.id_makanan %>"
                  data-makanan="<%= item.makanan %>"
                  data-harga="<%= item.harga %>"
                  data-stok="<%= item.stok %>"
                  data-deskripsi="<%= item.deskripsi %>"
                  class="text-stone-600 hover:text-stone-900">Edit</button>
                <button type="button" data-hapus
                  data-id="<%= item.id_makanan %>"
                  data-makanan="<%= item.makanan %>"
                  class="text-red-700 hover:text-red-800">Hapus</button>
              </div><% } %>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <section id="galeri" class="px-6 lg:px-10 py-8">
      <div class="flex items-baseline justify-between border-b border-stone-200 pb-4">
        <h2 class="text-xl font-semibold tracking-tight">Galeri Makanan</h2>
      </div>

      <div class="relative mt-6">
        <button type="button" data-galeri="prev" aria-label="Geser galeri ke kiri"
          class="absolute left-2 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-stone-300 bg-white/90 text-lg text-stone-700 hover:bg-white">
          &lt;
        </button>

        <div id="galeri-track" data-unique="<%= galeri.length %>" class="no-scrollbar flex gap-4 overflow-x-auto">
          <% for (let salinan = 0; salinan < 3; salinan++) { %>
            <% galeri.forEach(function (foto) { %>
              <figure class="h-48 w-64 shrink-0 overflow-hidden rounded-lg border border-stone-200 bg-white sm:h-60 sm:w-80">
                <img src="<%= foto.src %>" alt="<%= foto.alt %>" loading="lazy" class="h-full w-full object-cover">
              </figure>
            <% }); %>
          <% } %>
        </div>

        <button type="button" data-galeri="next" aria-label="Geser galeri ke kanan"
          class="absolute right-2 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-stone-300 bg-white/90 text-lg text-stone-700 hover:bg-white">
          &gt;
        </button>
      </div>
    </section>

    <section id="api" class="px-6 lg:px-10 py-8">
      <div class="border-b border-stone-200 pb-4">
        <h2 class="text-xl font-semibold tracking-tight">Endpoint API</h2>
      </div>

      <div class="mt-6 divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
        <a href="/api/status" class="flex flex-col gap-1 p-5 hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <span class="rounded bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-700">GET</span>
            <code class="text-sm">/api/status</code>
          </div>
          <span class="text-sm text-stone-500">Status server</span>
        </a>
        <a href="/api/produk" class="flex flex-col gap-1 p-5 hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <span class="rounded bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-700">GET</span>
            <code class="text-sm">/api/produk</code>
          </div>
          <span class="text-sm text-stone-500">Daftar produk</span>
        </a>
        <a href="/api/produk/1" class="flex flex-col gap-1 p-5 hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <span class="rounded bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-700">GET</span>
            <code class="text-sm">/api/produk/:id</code>
          </div>
          <span class="text-sm text-stone-500">produk ID 1</span>
        </a>
        <div class="flex flex-col gap-1 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <span class="rounded bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-700">POST</span>
            <code class="text-sm">/api/produk</code>
          </div>
          <span class="text-sm text-stone-500">Tambah produk</span>
        </div>
        <div class="flex flex-col gap-1 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <span class="rounded bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-700">PUT</span>
            <code class="text-sm">/api/produk/:id</code>
          </div>
          <span class="text-sm text-stone-500">Ubah produk</span>
        </div>
        <div class="flex flex-col gap-1 p-5 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <span class="rounded bg-stone-100 px-2 py-1 text-xs font-semibold text-stone-700">DELETE</span>
            <code class="text-sm">/api/produk/:id</code>
          </div>
          <span class="text-sm text-stone-500">Hapus produk</span>
        </div>
      </div>
    </section>
  </main>

  <% if (isAdmin) { %><div id="modal-produk" class="fixed inset-0 z-50 hidden items-center justify-center bg-stone-900/40 px-4">
    <div class="w-full max-w-md rounded-lg border border-stone-200 bg-white p-6">
      <div class="flex items-center justify-between">
        <h2 id="modal-judul" class="text-lg font-semibold tracking-tight">Tambah Produk</h2>
        <button type="button" id="btn-tutup" aria-label="Tutup form"
          class="flex h-8 w-8 items-center justify-center rounded-md text-stone-500 hover:bg-stone-100 hover:text-stone-900">
          &times;
        </button>
      </div>

      <form id="form-produk" class="mt-4 space-y-3">
        <input type="hidden" name="id">

        <div>
          <label for="input-makanan" class="text-sm text-stone-600">Nama makanan</label>
          <input id="input-makanan" name="makanan" required maxlength="50"
            class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="input-harga" class="text-sm text-stone-600">Harga</label>
            <input id="input-harga" name="harga" type="number" min="0" required
              class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none">
          </div>
          <div>
            <label for="input-stok" class="text-sm text-stone-600">Stok</label>
            <input id="input-stok" name="stok" type="number" min="0" required
              class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none">
          </div>
        </div>

        <div>
          <label for="input-deskripsi" class="text-sm text-stone-600">Deskripsi</label>
          <textarea id="input-deskripsi" name="deskripsi" rows="3" required maxlength="256"
            class="mt-1 w-full rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none"></textarea>
        </div>

        <p id="form-error" class="hidden text-sm text-red-700"></p>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" id="btn-batal"
            class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:border-stone-400">
            Batal
          </button>
          <button type="submit"
            class="rounded-md bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-800">
            Simpan
          </button>
        </div>
      </form>
    </div>
  </div><% } %>

  <script>
    (function () {
      const track = document.getElementById('galeri-track');
      const prev = document.querySelector('[data-galeri="prev"]');
      const next = document.querySelector('[data-galeri="next"]');
      if (!track || !prev || !next) return;

      const slides = Array.from(track.children);
      const unique = Number(track.dataset.unique) || 1;
      const loopWidth = slides[unique].offsetLeft - slides[0].offsetLeft;
      const step = slides[0].offsetWidth + 16;
      let paused = false;
      let resumeTimer;

      function autoScroll() {
        if (!paused && loopWidth > 0) {
          track.scrollLeft += 0.7;
          if (track.scrollLeft >= loopWidth) track.scrollLeft -= loopWidth;
        }
        requestAnimationFrame(autoScroll);
      }

      function pauseSementara() {
        paused = true;
        clearTimeout(resumeTimer);
        resumeTimer = setTimeout(() => { paused = false; }, 1800);
      }

      track.addEventListener('mouseenter', () => { paused = true; });
      track.addEventListener('mouseleave', () => { paused = false; });
      track.addEventListener('touchstart', pauseSementara, { passive: true });

      function geser(arah) {
        pauseSementara();
        track.scrollBy({ left: arah * step, behavior: 'smooth' });
      }

      prev.addEventListener('click', () => geser(-1));
      next.addEventListener('click', () => geser(1));

      requestAnimationFrame(autoScroll);
    })();
  </script>

  <script>
    (function () {
      const modal = document.getElementById('modal-produk');
      const form = document.getElementById('form-produk');
      const judul = document.getElementById('modal-judul');
      const errorBox = document.getElementById('form-error');
      const btnTambah = document.getElementById('btn-tambah');
      if (!modal || !form || !btnTambah) return;

      function bukaModal(produk) {
        form.reset();
        errorBox.classList.add('hidden');
        form.elements.id.value = produk ? produk.id : '';
        form.elements.makanan.value = produk ? produk.makanan : '';
        form.elements.harga.value = produk ? produk.harga : '';
        form.elements.stok.value = produk ? produk.stok : '';
        form.elements.deskripsi.value = produk ? produk.deskripsi : '';
        judul.textContent = produk ? 'Edit Produk' : 'Tambah Produk';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        form.elements.makanan.focus();
      }

      function tutupModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }

      btnTambah.addEventListener('click', () => bukaModal(null));
      document.getElementById('btn-tutup').addEventListener('click', tutupModal);
      document.getElementById('btn-batal').addEventListener('click', tutupModal);

      modal.addEventListener('click', (event) => {
        if (event.target === modal) tutupModal();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !modal.classList.contains('hidden')) tutupModal();
      });

      document.querySelectorAll('[data-edit]').forEach((tombol) => {
        tombol.addEventListener('click', () => bukaModal(tombol.dataset));
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorBox.classList.add('hidden');

        const data = Object.fromEntries(new FormData(form));
        const id = data.id;
        delete data.id;

        try {
          const response = await fetch(id ? `/api/produk/${id}` : '/api/produk', {
            method: id ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
            body: JSON.stringify(data),
          });
          const hasil = await response.json();

          if (!response.ok) {
            errorBox.textContent = hasil.message || 'Gagal menyimpan produk';
            errorBox.classList.remove('hidden');
            return;
          }

          window.location.reload();
        } catch (error) {
          errorBox.textContent = 'Tidak bisa menghubungi server';
          errorBox.classList.remove('hidden');
        }
      });

      document.querySelectorAll('[data-hapus]').forEach((tombol) => {
        tombol.addEventListener('click', async () => {
          if (!confirm(`Hapus "${tombol.dataset.makanan}"?`)) return;

          try {
            const response = await fetch(`/api/produk/${tombol.dataset.id}`, {
              method: 'DELETE',
              headers: { 'X-CSRF-Token': '<%= csrfToken %>' },
            });

            if (!response.ok) {
              alert('Gagal menghapus produk');
              return;
            }

            window.location.reload();
          } catch (error) {
            alert('Tidak bisa menghubungi server');
          }
        });
      });
    })();
  </script>

  <script>
    (function () {
      const formCek = document.getElementById('form-cek-pesanan');
      const hasilCek = document.getElementById('hasil-cek-pesanan');
      formCek.addEventListener('submit', async (event) => {
        event.preventDefault();
        hasilCek.textContent = 'Memeriksa kode pesanan...';
        const kode = new FormData(formCek).get('kode').trim();
        try {
          const response = await fetch(`/api/pesanan/status/${encodeURIComponent(kode)}`);
          const result = await response.json();
          hasilCek.textContent = response.ok
            ? `Pesanan ${result.data.kode_pesanan}: ${result.data.status}`
            : (result.message || 'Kode pesanan tidak ditemukan.');
        } catch (_) { hasilCek.textContent = 'Tidak bisa menghubungi server.'; }
      });

      const hasilUpdate = document.getElementById('hasil-update-status');
      document.querySelectorAll('[data-form-status]').forEach((form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const status = new FormData(form).get('status');
          try {
            const response = await fetch(`/api/pesanan/${form.dataset.id}/status`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
              body: JSON.stringify({ status }),
            });
            const result = await response.json();
            if (!response.ok) { hasilUpdate.textContent = result.message || 'Gagal memperbarui status.'; return; }
            window.location.reload();
          } catch (_) { hasilUpdate.textContent = 'Tidak bisa menghubungi server.'; }
        });
      });
    })();
  </script>

  <section id="chatbot-panel" aria-label="Chatbot makanan" aria-hidden="true"
    class="fixed bottom-24 right-4 z-40 hidden h-[min(36rem,calc(100vh-8rem))] w-[min(24rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-2xl sm:right-6">
    <header class="flex items-center justify-between bg-stone-900 px-4 py-3 text-white">
      <div>
        <h2 class="font-semibold">Chat Makanan Manado</h2>
        <p class="text-xs text-stone-300">Jawaban berdasarkan data katalog</p>
      </div>
      <button id="chat-close" type="button" aria-label="Tutup chatbot" class="rounded px-2 py-1 text-xl hover:bg-stone-700">&times;</button>
    </header>
    <div id="chat-messages" data-products="<%= JSON.stringify(produk.map(function (item) { return { id: item.id_makanan, nama: item.makanan, harga: item.harga }; })) %>" aria-live="polite" class="flex-1 space-y-3 overflow-y-auto bg-stone-50 p-4">
      <p class="max-w-[90%] rounded-lg bg-white p-3 text-sm shadow-sm">Halo! Ada Yang bisa saya bantu mengenai makanan manado?</p>
      <button type="button" data-chat-quick="menu" class="rounded-full border border-stone-300 bg-white px-3 py-1.5 text-sm text-stone-700 hover:bg-stone-100">Lihat Menu</button>
      <button type="button" data-order-start class="rounded-full border border-amber-700 bg-amber-700 px-3 py-1.5 text-sm text-white hover:bg-amber-800">Pesan Sekarang</button>
    </div>
    <form id="chat-form" class="flex gap-2 border-t border-stone-200 bg-white p-3">
      <input id="chat-input" name="message" maxlength="500" required autocomplete="off"
        placeholder="Tulis pertanyaan..." aria-label="Pertanyaan untuk chatbot"
        class="min-w-0 flex-1 rounded-md border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none">
      <button id="chat-send" type="submit" class="rounded-md bg-stone-900 px-3 py-2 text-sm font-medium text-white hover:bg-stone-800">Kirim</button>
    </form>
  </section>

  <button id="chat-toggle" type="button" aria-label="Buka chatbot makanan" aria-expanded="false"
    class="fixed bottom-5 right-4 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-stone-900 text-white shadow-lg hover:bg-stone-700 sm:right-6">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7">
      <path stroke-linecap="round" stroke-linejoin="round" d="M7 9h10M7 13h6m-7 7-3 1 1-4a8 8 0 1 1 3 3Z" />
    </svg>
  </button>

  <script>
    (function () {
      const panel = document.getElementById('chatbot-panel');
      const toggle = document.getElementById('chat-toggle');
      const close = document.getElementById('chat-close');
      const form = document.getElementById('chat-form');
      const input = document.getElementById('chat-input');
      const messages = document.getElementById('chat-messages');
      const send = document.getElementById('chat-send');
      const products = JSON.parse(messages.dataset.products || '[]');
      let orderStep = null;
      let orderDraft = null;

      function setOpen(open) {
        panel.classList.toggle('hidden', !open);
        panel.classList.toggle('flex', open);
        panel.classList.toggle('chat-open', open);
        panel.setAttribute('aria-hidden', String(!open));
        toggle.setAttribute('aria-expanded', String(open));
        if (open) input.focus();
      }

      function tambahPesan(text, fromUser) {
        const bubble = document.createElement('p');
        bubble.className = fromUser
          ? 'chat-message ml-auto max-w-[90%] rounded-lg bg-stone-900 p-3 text-sm text-white'
          : 'chat-message max-w-[90%] rounded-lg bg-white p-3 text-sm shadow-sm';
        bubble.textContent = text;
        messages.appendChild(bubble);
        messages.scrollTop = messages.scrollHeight;
        return bubble;
      }

      function tombolPilihan(label, attributes) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'mr-2 rounded-full border border-stone-300 bg-white px-3 py-1.5 text-sm text-stone-700 hover:bg-stone-100';
        button.textContent = label;
        Object.entries(attributes).forEach(([key, value]) => button.dataset[key] = value);
        messages.appendChild(button);
        messages.scrollTop = messages.scrollHeight;
      }

      function tampilkanPilihanMenu() {
        if (!products.length) {
          tambahPesan('Belum ada menu yang bisa dipesan. Silakan coba lagi nanti.', false);
          orderStep = null;
          return;
        }
        tambahPesan('Pilih menu yang ingin dipesan:', false);
        products.forEach((product) => tombolPilihan(`${product.nama} — ${new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number(product.harga))}`, { orderMenu: String(product.id) }));
      }

      function mulaiPesanan(idProduct) {
        orderDraft = {};
        if (idProduct) {
          const product = products.find((item) => String(item.id) === String(idProduct));
          if (!product) { tambahPesan('Menu tidak ditemukan. Silakan muat ulang halaman.', false); return; }
          orderDraft.product = product;
          orderStep = 'jumlah';
          tambahPesan(`Kamu memilih ${product.nama}. Berapa jumlah porsi yang ingin dipesan?`, false);
          return;
        }
        orderStep = 'menu';
        tampilkanPilihanMenu();
      }

      function formatTanggal(tanggal) {
        const [tahun, bulan, hari] = tanggal.split('-');
        const nilai = new Date(Date.UTC(Number(tahun), Number(bulan) - 1, Number(hari)));
        return /^\d{4}-\d{2}-\d{2}$/.test(tanggal) && nilai.toISOString().slice(0, 10) === tanggal;
      }

      async function prosesJawabanPesanan(message) {
        const jawaban = message.trim();
        if (orderStep === 'menu') {
          const product = products.find((item) => String(item.id) === jawaban || item.nama.toLocaleLowerCase('id-ID') === jawaban.toLocaleLowerCase('id-ID'));
          if (!product) { tambahPesan('Pilih menu dari tombol yang tersedia atau ketik nama menu dengan tepat.', false); return; }
          orderDraft.product = product;
          orderStep = 'jumlah';
          tambahPesan('Berapa jumlah porsi yang ingin dipesan?', false);
        } else if (orderStep === 'jumlah') {
          const jumlah = Number(jawaban);
          if (!Number.isInteger(jumlah) || jumlah < 1 || jumlah > 10000) { tambahPesan('Masukkan jumlah porsi berupa angka bulat minimal 1.', false); return; }
          orderDraft.jumlah = jumlah;
          orderStep = 'tanggal';
          tambahPesan('Tanggal acara kapan? Gunakan format YYYY-MM-DD, contoh 2026-12-25.', false);
        } else if (orderStep === 'tanggal') {
          if (!formatTanggal(jawaban)) { tambahPesan('Format tanggal belum valid. Gunakan YYYY-MM-DD, contoh 2026-12-25.', false); return; }
          orderDraft.tanggal = jawaban;
          orderStep = 'nama';
          tambahPesan('Siapa nama pemesan?', false);
        } else if (orderStep === 'nama') {
          if (!jawaban || jawaban.length > 100) { tambahPesan('Nama wajib diisi dan maksimal 100 karakter.', false); return; }
          orderDraft.nama = jawaban;
          orderStep = 'alamat';
          tambahPesan('Tuliskan alamat pengantaran.', false);
        } else if (orderStep === 'alamat') {
          if (!jawaban || jawaban.length > 500) { tambahPesan('Alamat wajib diisi dan maksimal 500 karakter.', false); return; }
          orderDraft.alamat = jawaban;
          orderStep = 'konfirmasi';
          const total = Number(orderDraft.product.harga) * orderDraft.jumlah;
          const rupiah = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(total);
          tambahPesan(`Rangkuman pesanan:\nNama: ${orderDraft.nama}\nMenu: ${orderDraft.product.nama}\nJumlah: ${orderDraft.jumlah} porsi\nTanggal: ${orderDraft.tanggal}\nAlamat: ${orderDraft.alamat}\nTotal: ${rupiah}\n\nKetik "Ya" untuk menyimpan atau "Ubah" untuk mengisi ulang.`, false);
          tombolPilihan('Ya, konfirmasi', { orderAction: 'ya' });
          tombolPilihan('Ubah pesanan', { orderAction: 'ubah' });
        } else if (orderStep === 'konfirmasi') {
          if (/^ubah$/i.test(jawaban)) {
            tambahPesan('Baik, kita mulai ulang pesanan.', false);
            mulaiPesanan();
          } else if (/^ya$/i.test(jawaban)) {
            await kirimPesanan();
          } else {
            tambahPesan('Pilih "Ya, konfirmasi" untuk menyimpan atau "Ubah pesanan" untuk mengulang.', false);
          }
        }
      }

      async function kirimPesanan() {
        try {
          const response = await fetch('/api/pesanan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              nama: orderDraft.nama,
              id_makanan: orderDraft.product.id,
              jumlah: orderDraft.jumlah,
              tanggal_acara: orderDraft.tanggal,
              alamat: orderDraft.alamat,
            }),
          });
          const result = await response.json();
          if (!response.ok) { tambahPesan(result.message || 'Pesanan gagal disimpan. Silakan coba lagi.', false); return; }
          orderStep = null;
          orderDraft = null;
          tambahPesan(`Pesanan berhasil dicatat. Kode pesanan kamu: ${result.data.kode_pesanan}. Simpan kode ini untuk mengecek status pesanan.`, false);
        } catch (_) { tambahPesan('Tidak bisa menghubungi server. Pesanan belum tersimpan, silakan coba lagi.', false); }
      }

      toggle.addEventListener('click', () => setOpen(panel.classList.contains('hidden')));
      close.addEventListener('click', () => setOpen(false));
      messages.addEventListener('click', (event) => {
        const startButton = event.target.closest('[data-order-start]');
        if (startButton) { tambahPesan('Saya ingin memesan.', true); mulaiPesanan(); return; }
        const menuButton = event.target.closest('[data-order-menu]');
        if (menuButton) { const product = products.find((item) => String(item.id) === menuButton.dataset.orderMenu); if (product) { tambahPesan(product.nama, true); prosesJawabanPesanan(String(product.id)); } return; }
        const actionButton = event.target.closest('[data-order-action]');
        if (actionButton) { const action = actionButton.dataset.orderAction; tambahPesan(action === 'ya' ? 'Ya' : 'Ubah', true); prosesJawabanPesanan(action); return; }
        const quickButton = event.target.closest('[data-chat-quick]');
        if (!quickButton) return;
        input.value = quickButton.dataset.chatQuick;
        form.requestSubmit();
      });
      document.querySelectorAll('[data-order-product]').forEach((button) => {
        button.addEventListener('click', () => {
          setOpen(true);
          tambahPesan(`Saya ingin memesan ${button.closest('article').querySelector('h3').textContent}.`, true);
          mulaiPesanan(button.dataset.orderProduct);
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !panel.classList.contains('hidden')) setOpen(false);
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const message = input.value.trim();
        if (!message) return;
        tambahPesan(message, true);
        input.value = '';
        if (orderStep) { prosesJawabanPesanan(message); return; }
        input.disabled = true;
        send.disabled = true;
        send.textContent = '...';
        const pending = tambahPesan('Sedang mencari di data makanan...', false);

        try {
          const response = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message }),
          });
          const result = await response.json();
          pending.textContent = result.reply || result.message || 'Maaf, chatbot sedang tidak bisa menjawab.';
        } catch (error) {
          pending.textContent = 'Tidak bisa menghubungi server. Coba lagi nanti.';
        } finally {
          input.disabled = false;
          send.disabled = false;
          send.textContent = 'Kirim';
          input.focus();
          messages.scrollTop = messages.scrollHeight;
        }
      });
    })();
  </script>

<%- include('partials/footer', { appName }) %>
